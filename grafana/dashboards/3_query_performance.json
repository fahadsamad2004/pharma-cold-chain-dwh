 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "**How to read:** tiles show the latest value with its trend; colours follow thresholds (green = healthy, orange = watch, red = act). Hover the (i) icon on a tile for its definition. Spec metrics: **Query Execution Time** (`time.perf_counter()` wrapper), **Daily Active Query Count** (counter per executed query), **Query Error Rate** (failed / total x 100)."
   },
   "transparent": true
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Queries today",
   "description": "queries executed so far today (counter incremented for every executed query)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pharma-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pharma-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT executed_at AS time, COUNT(*) OVER (PARTITION BY date_trunc('day', executed_at) ORDER BY executed_at) AS queries FROM ops.query_log WHERE $__timeFilter(executed_at) ORDER BY 1"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "auto",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#5794F2",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Error rate",
   "description": "(failed queries / total executed queries) x 100",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pharma-pg"
   },
   "gridPos": {
    "x": 4,
    "y": 2,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pharma-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT executed_at AS time, ROUND(100.0 * AVG((status = 'failed')::int) OVER (ORDER BY executed_at), 2) AS \"error %\" FROM ops.query_log WHERE $__timeFilter(executed_at) ORDER BY 1"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "auto",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#73BF69",
        "value": null
       },
       {
        "color": "#FF9830",
        "value": 1
       },
       {
        "color": "#F2495C",
        "value": 5
       }
      ]
     },
     "unit": "percent"
    },
    "overrides": []
   }
  },
