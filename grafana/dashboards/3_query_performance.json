{
 "uid": "p1-query",
 "title": "3 - Query Performance Monitor",
 "description": "Analytical query layer: execution time, query count, error rate.",
 "tags": [
  "pharma-phase1",
  "query"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
