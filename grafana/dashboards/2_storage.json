     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT domain, table_name, to_char(min_date, 'YYYY-MM-DD') AS min_date, to_char(max_date, 'YYYY-MM-DD') AS max_date, distinct_months, expected_months, coverage_pct FROM ops.date_coverage WHERE captured_at = (SELECT MAX(captured_at) FROM ops.date_coverage)"
