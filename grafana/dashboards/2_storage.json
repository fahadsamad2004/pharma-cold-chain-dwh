   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pharma-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT 'Largest staging domain' AS insight, source_domain || ' - ' || row_count || ' rows' AS detail FROM (SELECT * FROM ops.storage_snapshot WHERE layer = 'staging' AND captured_at = (SELECT MAX(captured_at) FROM ops.storage_snapshot) ORDER BY row_count DESC LIMIT 1) a\n             UNION ALL SELECT 'Largest warehouse table', table_name || ' - ' || row_count || ' rows' FROM (SELECT * FROM ops.storage_snapshot WHERE layer = 'dwh' AND captured_at = (SELECT MAX(captured_at) FROM ops.storage_snapshot) ORDER BY row_count DESC LIMIT 1) b\n             UNION ALL SELECT 'Latest snapshot', to_char(MAX(captured_at), 'YYYY-MM-DD HH24:MI') FROM ops.storage_snapshot\n             UNION ALL SELECT 'Snapshots taken', COUNT(DISTINCT captured_at)::text FROM ops.storage_snapshot"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
