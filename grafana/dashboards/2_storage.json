  {
   "id": 17,
   "type": "table",
   "title": "Insights",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pharma-pg"
   },
   "gridPos": {
    "x": 16,
    "y": 27,
