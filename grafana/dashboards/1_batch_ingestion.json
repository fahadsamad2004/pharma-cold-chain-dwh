{
 "uid": "p1-batch",
 "title": "1 - Batch Ingestion Monitor",
 "description": "Batch ingestion: load duration, rows processed, success rate.",
 "tags": [
  "pharma-phase1",
  "ingestion"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "5s",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "style": "dark",
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "**How to read:** tiles show the latest value with its trend; colours follow thresholds (green = healthy, orange = watch, red = act). Hover the (i) icon on a tile for its definition. Spec metrics: **Batch Load Duration** (end - start), **Rows Processed** (`len(df)`), **Batch Success Rate** (successful / attempted x 100). Use the *Source domain* filter and the time picker above."
   },
   "transparent": true
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Success rate",
   "description": "(successful runs / total attempted runs) x 100",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pharma-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pharma-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT started_at AS time, ROUND(100.0 * AVG((status = 'success')::int) OVER (ORDER BY started_at), 1) AS \"success %\" FROM ops.batch_load_log WHERE $__timeFilter(started_at) AND ('$domain' = 'All' OR source_domain = '$domain') ORDER BY 1"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "auto",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#F2495C",
        "value": null
       },
       {
        "color": "#FF9830",
        "value": 90
       },
       {
        "color": "#73BF69",
        "value": 99
       }
      ]
     },
     "unit": "percent"
    },
    "overrides": []
   }
  },
