      "uid": "pharma-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT 'Slowest load' AS insight, file_name || ' - ' || duration_sec || ' s' AS detail FROM (SELECT * FROM ops.batch_load_log WHERE $__timeFilter(started_at) ORDER BY duration_sec DESC NULLS LAST LIMIT 1) a\n              UNION ALL SELECT 'Largest load', file_name || ' - ' || rows_loaded || ' rows' FROM (SELECT * FROM ops.batch_load_log WHERE $__timeFilter(started_at) ORDER BY rows_loaded DESC NULLS LAST LIMIT 1) b\n              UNION ALL SELECT 'Most frequent reject', left(reason, 50) || ' (' || n || ')' FROM (SELECT reason, COUNT(*) n FROM stg.rejected_rows GROUP BY 1 ORDER BY 2 DESC LIMIT 1) c\n              UNION ALL SELECT 'Failed batches', COUNT(*) FILTER (WHERE status = 'failed') || ' of ' || COUNT(*) FROM ops.batch_load_log WHERE $__timeFilter(started_at)"
    }
